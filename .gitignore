# Personal IDE metadata
.idea/
.vscode/
*.iml

# Admin UI, Cloudflare Functions, content data, assets, and operations docs are intentionally tracked for handoff.

# Local browser/UI test output (never production source)
.test-artifacts/
playwright-report/
test-results/
coverage/

# Optional local tooling caches and dependencies
node_modules/
.npm/

# Deterministic build output (Cloudflare rebuilds this from source)
dist/

# Cloudflare/Wrangler local state and secrets (share only the examples)
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Generic environment files can contain credentials
.env
.env.*
!.env.example

# Private keys, certificates, and service credentials
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials*.json
*service-account*.json

# Local process output
*.log
*.pid
*.tmp

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
